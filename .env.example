# ============================================================
#  APTIS V2 — .env cho PRODUCTION (nhaiaptis.com)
#  Cách dùng: copy file này thành .env rồi điền các chỗ "← ĐIỀN".
#  KHÔNG commit file .env (đã gitignore).
# ============================================================

APP_NAME="nhaiaptis"
APP_ENV=production
APP_KEY=                       # ← chạy: php artisan key:generate (tự điền)
APP_DEBUG=false
APP_URL=https://nhaiaptis.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─────────────────────────────────────────────────────────────
#  DB2 — DATABASE RIÊNG CỦA V2 (users/đơn/lịch sử làm bài)
#  ⚠️ PHẢI là database MỚI, KHÁC db1. TẠO MỚI trong cPanel.
#  ❌ TUYỆT ĐỐI KHÔNG đặt = ujxmchhx_aptis_v2 (đó là db v1 đang chạy)
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ujxmchhx_aptis_forme     # ← tên db2 MỚI bạn tạo (đổi nếu khác)
DB_USERNAME=ujxmchhx_ujxmchhx
DB_PASSWORD=                          # ← ĐIỀN mật khẩu MySQL

# ─────────────────────────────────────────────────────────────
#  DB1 — LEGACY, CHỈ ĐỌC: kho nội dung của v1 đang chạy
#  Cùng MySQL server nên host nội bộ 127.0.0.1. KHÔNG migrate db này.
# ─────────────────────────────────────────────────────────────
DB_LEGACY_HOST=127.0.0.1
DB_LEGACY_PORT=3306
DB_LEGACY_DATABASE=ujxmchhx_aptis_v2
DB_LEGACY_USERNAME=ujxmchhx_ujxmchhx
DB_LEGACY_PASSWORD=                   # ← ĐIỀN (thường cùng mật khẩu ở trên)

# ─────────────────────────────────────────────────────────────
#  Session / Cache / Queue (dùng db2)
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─────────────────────────────────────────────────────────────
#  OpenAI — chấm AI Writing/Speaking (BẮT BUỘC nếu muốn có chấm AI)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=                       # ← ĐIỀN key OpenAI
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
AI_WRITING_LIMIT=10
AI_SPEAKING_LIMIT=10

# ─────────────────────────────────────────────────────────────
#  PayOS — thanh toán (TÀI KHOẢN MỚI của v2)
#  Test không mất tiền: đặt PAYOS_FAKE=true.
#  Chạy thật: PAYOS_FAKE=false + điền 3 khóa dưới.
# ─────────────────────────────────────────────────────────────
PAYOS_FAKE=true
PAYOS_VERIFY_SSL=true
PAYOS_CLIENT_ID=                      # ← ĐIỀN khi chạy thật
PAYOS_API_KEY=                        # ← ĐIỀN khi chạy thật
PAYOS_CHECKSUM_KEY=                   # ← ĐIỀN khi chạy thật

# ─────────────────────────────────────────────────────────────
#  Giá gói (VND) — ghi đè config/pricing.php
# ─────────────────────────────────────────────────────────────
PRICE_WEEK=199000
PRICE_WEEK_ORIGINAL=399000
PRICE_MONTH=349000
PRICE_MONTH_ORIGINAL=699000

# ─────────────────────────────────────────────────────────────
#  Mail — gửi thông tin tài khoản sau thanh toán
#  Chưa có SMTP: để MAIL_MAILER=log (email ghi vào log, cấp tay).
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=                            # ← ĐIỀN (vd mail.nhaiaptis.com)
MAIL_PORT=587
MAIL_USERNAME=                        # ← ĐIỀN
MAIL_PASSWORD=                        # ← ĐIỀN
MAIL_FROM_ADDRESS="no-reply@nhaiaptis.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
#  Giới hạn thiết bị (chống share tài khoản) — mặc định ổn
# ─────────────────────────────────────────────────────────────
DEVICE_MAX=2
DEVICE_ACTIVITY_WINDOW_HOURS=12
DEVICE_BLOCK_AFTER_VIOLATIONS=3
DEVICE_VIOLATION_RESET_DAYS=30

VITE_APP_NAME="${APP_NAME}"
