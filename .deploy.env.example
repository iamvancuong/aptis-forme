# Cấu hình deploy UI qua SSH — copy file này thành .deploy.env rồi điền thật.
# .deploy.env KHÔNG được commit (đã có trong .gitignore).

# Host SSH của hosting (domain hoặc IP)
SSH_HOST=nhaiaptis.com

# User SSH trên cPanel (thường là user cPanel, vd ujxmchhx)
SSH_USER=ujxmchhx

# Cổng SSH (cPanel hay dùng 22; một số nơi đổi cổng riêng)
SSH_PORT=22

# Đường dẫn TUYỆT ĐỐI tới thư mục app v2 trên server (thư mục CHỨA public/)
# Ví dụ: /home/ujxmchhx/aptis-v2
REMOTE_APP=/home/ujxmchhx/aptis-v2
